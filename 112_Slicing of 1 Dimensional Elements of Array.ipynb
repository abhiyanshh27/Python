    "import numpy as np\n",
    "a=[]\n",
    "size = int(input(\"How many Numbers?\"))\n",
    "\n",
    "for i in range (size):\n",
    "    val=int(input(\"Enter number:\"))\n",
    "    a.append(val)\n",
    "arr=np.array(a)\n",
    "\n",
    "for i in range (arr.size):\n",
    "    print(arr[i])\n",
    "\n",
    "arr1 = arr[2:4]\n",
    "print(arr1)"
